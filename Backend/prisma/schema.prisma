generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


// ======================================================
// ADMIN
// ======================================================

model Admin {
  adminId      Int      @id @default(autoincrement()) @map("admin_id")
  adminName    String   @map("admin_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.Text
  companyId    Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company          companies        @relation(fields: [companyId], references: [company_id])
  approvedAdvances AdvancePayment[] @relation("ApprovedAdvances")

  @@index([companyId])
  @@map("admin")
}


// ======================================================
// BRANCH
// ======================================================

model Branch {
  branchId   Int      @id @default(autoincrement()) @map("branch_id")
  branchName String   @map("branch_name") @db.VarChar(100)
  location   String   @db.VarChar(150)
  companyId  Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company     companies    @relation(fields: [companyId], references: [company_id])
  departments Department[]
  employees   Employee[]
  devices     IotDevice[]

  @@index([companyId])
  @@map("branches")
}


// ======================================================
// DEPARTMENT
// ======================================================

model Department {
  departmentId   Int      @id @default(autoincrement()) @map("department_id")
  departmentName String   @map("department_name") @db.VarChar(100)
  branchId       Int
  companyId      Int
  managerId      Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch    Branch     @relation(fields: [branchId], references: [branchId])
  company   companies  @relation(fields: [companyId], references: [company_id])
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [employeeId])
  employees Employee[] @relation("EmployeeDepartment")

  @@index([branchId])
  @@index([companyId])
  @@index([managerId])
  @@map("departments")
}


// ======================================================
// EMPLOYEE
// ======================================================

model Employee {
  employeeId        Int       @id @default(autoincrement()) @map("employee_id")
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  gender            String?   @db.VarChar(20)
  email             String    @unique @db.VarChar(150)
  phone             String?   @db.VarChar(20)
  hireDate          DateTime? @map("hire_date") @db.Date
  role              String    @db.VarChar(30)

  // Monthly/base salary
  baseSalary        Decimal?  @map("base_salary") @db.Decimal(12, 2)

  // Expected working hours per month
  monthlyExpectedHours Decimal? @map("monthly_expected_hours") @db.Decimal(8, 2)

  // Calculated hourly rate
  // baseSalary / monthlyExpectedHours
  salaryRatePerHour Decimal?  @map("salary_rate_per_hour") @db.Decimal(10, 2)

  companyId         Int
  branchId          Int
  departmentId      Int?
  managerId         Int?
  status            String    @db.VarChar(20)
  passwordHash      String    @map("password_hash") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  activityLogs       ActivityLog[]
  advancePayments    AdvancePayment[] @relation("EmployeeAdvances")
  attendance         Attendance[]
  attendancePunches  AttendancePunch[]
  managedDepartments Department[]     @relation("DepartmentManager")

  branch       Branch      @relation(fields: [branchId], references: [branchId])
  company      companies   @relation(fields: [companyId], references: [company_id])
  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [departmentId])
  manager      Employee?   @relation("EmployeeManager", fields: [managerId], references: [employeeId])
  subordinates Employee[]  @relation("EmployeeManager")

  fingerprintEnrollments FingerprintEnrollment[]
  fingerprintTemplates   FingerprintTemplate[]

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  payrolls Payroll[]

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}


// ======================================================
// IOT DEVICE
// ======================================================

model IotDevice {
  deviceId         Int       @id @default(autoincrement()) @map("device_id")
  deviceCode       String    @unique @map("device_code") @db.VarChar(50)
  deviceName       String    @map("device_name") @db.VarChar(100)
  branchId         Int
  companyId        Int
  location         String?   @db.VarChar(150)
  status           String    @db.VarChar(20)
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deviceSecretHash String?   @map("device_secret_hash") @db.VarChar(255)

  attendancePunches AttendancePunch[]
  deviceLogs        DeviceLog[]

  branch  Branch    @relation(fields: [branchId], references: [branchId])
  company companies @relation(fields: [companyId], references: [company_id])

  @@index([branchId])
  @@index([companyId])
  @@map("iot_devices")
}


// ======================================================
// FINGERPRINT TEMPLATE
// ======================================================

model FingerprintTemplate {
  templateId Int      @id @default(autoincrement()) @map("template_id")
  employeeId Int
  sensorSlot Int      @unique @map("sensor_slot")
  fingerName String?  @map("finger_name") @db.VarChar(30)
  status     String   @db.VarChar(20)
  enrolledAt DateTime @map("enrolled_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@map("fingerprint_templates")
}


// ======================================================
// ATTENDANCE PUNCH
// ======================================================

model AttendancePunch {
  punchId    BigInt   @id @default(autoincrement()) @map("punch_id")
  employeeId Int
  deviceId   Int
  sensorSlot Int      @map("sensor_slot")
  punchType  String   @map("punch_type") @db.VarChar(10)
  punchedAt  DateTime @map("punched_at")
  createdAt  DateTime @default(now()) @map("created_at")

  device   IotDevice @relation(fields: [deviceId], references: [deviceId])
  employee Employee  @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([deviceId])
  @@index([sensorSlot])
  @@index([punchedAt])
  @@map("attendance_punches")
}


// ======================================================
// ATTENDANCE
// ======================================================

model Attendance {
  attendanceId Int       @id @default(autoincrement()) @map("attendance_id")
  employeeId   Int
  date         DateTime  @db.Date
  checkInTime  DateTime? @map("check_in_time") @db.Time(0)
  checkOutTime DateTime? @map("check_out_time") @db.Time(0)
  totalHours   Decimal?  @map("total_hours") @db.Decimal(5, 2)
  status       String    @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}


// ======================================================
// DEVICE LOG
// ======================================================

model DeviceLog {
  logId     BigInt   @id @default(autoincrement()) @map("log_id")
  deviceId  Int
  eventType String   @map("event_type") @db.VarChar(50)
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  device IotDevice @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId])
  @@index([eventType])
  @@index([createdAt])
  @@map("device_logs")
}


// ======================================================
// ADVANCE PAYMENT
// ======================================================

model AdvancePayment {
  advanceId           Int       @id @default(autoincrement()) @map("advance_id")
  employeeId          Int

  // Original amount requested by employee
  amount              Decimal   @db.Decimal(10, 2)

  // Amount approved by admin
  approvedAmount      Decimal?  @map("approved_amount") @db.Decimal(10, 2)

  // Actual amount paid by admin
  paidAmount          Decimal?  @map("paid_amount") @db.Decimal(10, 2)

  reason              String?   @db.Text
  paymentDate         DateTime  @map("payment_date") @db.Date

  approvedBy          Int?
  status              String    @db.VarChar(20)

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deductedAt          DateTime? @map("deducted_at")

  // Payroll that deducted this advance
  deductedInPayrollId Int?      @unique @map("deducted_in_payroll_id")

  approver          Admin?   @relation("ApprovedAdvances", fields: [approvedBy], references: [adminId])
  deductedInPayroll Payroll? @relation("AdvancePayroll", fields: [deductedInPayrollId], references: [payrollId])
  employee          Employee @relation("EmployeeAdvances", fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([approvedBy])
  @@map("advance_payments")
}


// ======================================================
// PAYROLL
// ======================================================

model Payroll {
  payrollId         Int       @id @default(autoincrement()) @map("payroll_id")
  employeeId        Int

  payPeriodStart    DateTime  @map("pay_period_start") @db.Date
  payPeriodEnd      DateTime  @map("pay_period_end") @db.Date

  // ====================================================
  // HISTORICAL SALARY SNAPSHOT
  //
  // Nullable because old payroll records already exist.
  // New payrolls will populate these fields.
  // ====================================================

  baseSalary          Decimal? @map("base_salary") @db.Decimal(12, 2)
  monthlyExpectedHours Decimal? @map("monthly_expected_hours") @db.Decimal(8, 2)
  salaryRatePerHour   Decimal? @map("salary_rate_per_hour") @db.Decimal(10, 2)

  // ====================================================
  // ACTUAL PAYROLL CALCULATIONS
  // ====================================================

  // Actual hours worked during the payroll period
  totalWorkingHours Decimal @map("total_working_hours") @db.Decimal(8, 2)

  // Earned salary:
  // totalWorkingHours × salaryRatePerHour
  basicSalary Decimal @map("basic_salary") @db.Decimal(12, 2)

  // Actual advance amount deducted
  advanceDeduction Decimal @default(0.00) @map("advance_deduction") @db.Decimal(12, 2)

  // Final salary after deductions
  netSalary Decimal @map("net_salary") @db.Decimal(12, 2)

  paymentDate DateTime? @map("payment_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  advanceDeductionRecord AdvancePayment? @relation("AdvancePayroll")
  employee               Employee        @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([payPeriodStart, payPeriodEnd])
  @@map("payroll")
}


// ======================================================
// ACTIVITY LOG
// ======================================================

model ActivityLog {
  logId       BigInt   @id @default(autoincrement()) @map("log_id")
  employeeId  Int?
  actionType  String   @map("action_type") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}


// ======================================================
// SETTINGS
// ======================================================

model Setting {
  settingId Int      @id @default(autoincrement()) @map("setting_id")
  companyId Int
  key       String   @db.VarChar(100)
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company companies @relation(fields: [companyId], references: [company_id])

  @@unique([companyId, key])
  @@index([companyId])
  @@map("settings")
}


// ======================================================
// COMPANY
// ======================================================

model companies {
  company_id    Int      @id @default(autoincrement())
  company_name  String   @db.VarChar(150)
  address       String?  @db.Text
  contact_email String?  @db.VarChar(150)
  contact_phone String?  @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime

  admins      Admin[]
  branches    Branch[]
  departments Department[]
  employees   Employee[]
  devices     IotDevice[]
  leaveTypes  LeaveType[]
  settings    Setting[]
}


// ======================================================
// LEAVE TYPE
// ======================================================

model LeaveType {
  leaveTypeId       Int      @id @default(autoincrement()) @map("leave_type_id")
  companyId         Int      @map("company_id")
  name              String   @db.VarChar(100)
  code              String   @db.VarChar(30)
  description       String?  @db.Text
  annualQuota       Decimal? @map("annual_quota") @db.Decimal(6, 2)
  isPaid            Boolean  @default(true) @map("is_paid")
  requiresApproval  Boolean  @default(true) @map("requires_approval")
  allowHalfDay      Boolean  @default(true) @map("allow_half_day")
  allowCarryForward Boolean  @default(false) @map("allow_carry_forward")
  status            String   @default("ACTIVE") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]
  company  companies      @relation(fields: [companyId], references: [company_id])

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@map("leave_types")
}


// ======================================================
// LEAVE BALANCE
// ======================================================

model LeaveBalance {
  leaveBalanceId Int      @id @default(autoincrement()) @map("leave_balance_id")
  employeeId     Int      @map("employee_id")
  leaveTypeId    Int      @map("leave_type_id")
  year           Int
  allocated      Decimal  @default(0.00) @db.Decimal(6, 2)
  used           Decimal  @default(0.00) @db.Decimal(6, 2)
  remaining      Decimal  @default(0.00) @db.Decimal(6, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [employeeId])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}


// ======================================================
// LEAVE REQUEST
// ======================================================

model LeaveRequest {
  leaveRequestId Int @id @default(autoincrement()) @map("leave_request_id")
  employeeId     Int @map("employee_id")
  leaveTypeId    Int @map("leave_type_id")

  // Original requested leave dates
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  totalDays Decimal  @map("total_days") @db.Decimal(6, 2)

  // Employee reason
  reason String? @db.Text

  // Request status
  status String @default("PENDING") @db.VarChar(20)

  // Approval information
  approvedBy Int?      @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  // Approved leave period
  approvedStartDate DateTime? @map("approved_start_date") @db.Date
  approvedEndDate   DateTime? @map("approved_end_date") @db.Date
  approvedDays      Decimal?  @map("approved_days") @db.Decimal(6, 2)

  // Rejection information
  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [employeeId])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedStartDate, approvedEndDate])
  @@map("leave_requests")
}


// ======================================================
// FINGERPRINT ENROLLMENT
// ======================================================

model FingerprintEnrollment {
  enrollmentId Int       @id @default(autoincrement()) @map("enrollment_id")
  employeeId   Int       @map("employee_id")
  sensorSlot   Int       @map("sensor_slot")
  fingerName   String?   @map("finger_name") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(20)
  confidence   Int?
  errorMessage String?   @map("error_message") @db.Text
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([status])
  @@index([sensorSlot])
  @@index([createdAt])
  @@map("fingerprint_enrollments")
}