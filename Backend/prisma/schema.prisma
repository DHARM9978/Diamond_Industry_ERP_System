generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ======================================================
// ADMIN
// ======================================================

model Admin {
  adminId      Int      @id @default(autoincrement()) @map("admin_id")
  adminName    String   @map("admin_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.Text
  companyId    Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company             companies        @relation(fields: [companyId], references: [company_id])
  approvedAdvances    AdvancePayment[] @relation("ApprovedAdvances")
  attendanceOverrides Attendance[]     @relation("AttendanceManualOverride")

  // Diamond Job Work module audit relationships
  jobWorkOrdersCreated           JobWorkOrder[]          @relation("JobWorkOrderCreatedBy")
  jobWorkDispatchesCreated       JobWorkDispatch[]       @relation("JobWorkDispatchCreatedBy")
  jobWorkReceiptsRecorded        JobWorkReceipt[]        @relation("JobWorkReceiptRecordedBy")
  jobWorkReconciliationsReviewed JobWorkReconciliation[] @relation("JobWorkReconciliationReviewedBy")
  jobWorkPaymentsRecorded        JobWorkPayment[]        @relation("JobWorkPaymentRecordedBy")

  @@index([companyId])
  @@map("admin")
}

// ======================================================
// BRANCH
// ======================================================

model Branch {
  branchId   Int      @id @default(autoincrement()) @map("branch_id")
  branchName String   @map("branch_name") @db.VarChar(100)
  location   String   @db.VarChar(150)
  companyId  Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company        companies       @relation(fields: [companyId], references: [company_id])
  departments    Department[]
  employees      Employee[]
  devices        IotDevice[]
  publicHolidays PublicHoliday[]
  jobWorkOrders  JobWorkOrder[]

  @@index([companyId])
  @@map("branches")
}

// ======================================================
// DEPARTMENT
// ======================================================

model Department {
  departmentId   Int      @id @default(autoincrement()) @map("department_id")
  departmentName String   @map("department_name") @db.VarChar(100)
  branchId       Int
  companyId      Int
  managerId      Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch    Branch     @relation(fields: [branchId], references: [branchId])
  company   companies  @relation(fields: [companyId], references: [company_id])
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [employeeId])
  employees Employee[] @relation("EmployeeDepartment")

  @@index([branchId])
  @@index([companyId])
  @@index([managerId])
  @@map("departments")
}

// ======================================================
// EMPLOYEE
// ======================================================

model Employee {
  employeeId Int       @id @default(autoincrement()) @map("employee_id")
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  gender     String?   @db.VarChar(20)
  email      String    @unique @db.VarChar(150)
  phone      String?   @db.VarChar(20)
  hireDate   DateTime? @map("hire_date") @db.Date
  role       String    @db.VarChar(30)

  // Monthly/base salary
  baseSalary Decimal? @map("base_salary") @db.Decimal(12, 2)

  // Expected working hours per month
  monthlyExpectedHours Decimal? @map("monthly_expected_hours") @db.Decimal(8, 2)

  // Calculated hourly rate
  // baseSalary / monthlyExpectedHours
  salaryRatePerHour Decimal? @map("salary_rate_per_hour") @db.Decimal(10, 2)

  companyId    Int
  branchId     Int
  departmentId Int?
  managerId    Int?
  status       String   @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activityLogs           ActivityLog[]
  advancePayments        AdvancePayment[]        @relation("EmployeeAdvances")
  attendance             Attendance[]
  attendancePunches      AttendancePunch[]
  managedDepartments     Department[]            @relation("DepartmentManager")
  fingerprintEnrollments FingerprintEnrollment[]
  fingerprintTemplates   FingerprintTemplate[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  payrolls               Payroll[]

  // Extra-work accumulation and settlement history
  extraWorkRecords     ExtraWork[]
  extraWorkSettlements ExtraWorkSettlement[]

  branch       Branch      @relation(fields: [branchId], references: [branchId])
  company      companies   @relation(fields: [companyId], references: [company_id])
  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [departmentId])
  manager      Employee?   @relation("EmployeeManager", fields: [managerId], references: [employeeId])
  subordinates Employee[]  @relation("EmployeeManager")

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

// ======================================================
// IOT DEVICE
// ======================================================

model IotDevice {
  deviceId         Int       @id @default(autoincrement()) @map("device_id")
  deviceCode       String    @unique @map("device_code") @db.VarChar(50)
  deviceName       String    @map("device_name") @db.VarChar(100)
  branchId         Int
  companyId        Int
  location         String?   @db.VarChar(150)
  status           String    @db.VarChar(20)
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deviceSecretHash String?   @map("device_secret_hash") @db.VarChar(255)

  // Remote Wi-Fi configuration state
  wifiConfigEncrypted      String?   @map("wifi_config_encrypted") @db.Text
  wifiConfigVersion        Int       @default(0) @map("wifi_config_version")
  wifiConfigStatus         String    @default("NOT_CONFIGURED") @map("wifi_config_status") @db.VarChar(30)
  wifiConfigUpdatedAt      DateTime? @map("wifi_config_updated_at")
  wifiConfigAcknowledgedAt DateTime? @map("wifi_config_acknowledged_at")
  wifiActiveNetwork        String?   @map("wifi_active_network") @db.VarChar(20)

  // SSID of the Wi-Fi network currently connected to the ESP32.
  // Wi-Fi passwords are never stored here.
  wifiActiveSsid String? @map("wifi_active_ssid") @db.VarChar(100)
  wifiLastError  String? @map("wifi_last_error") @db.Text

  attendancePunches AttendancePunch[]
  deviceLogs        DeviceLog[]

  branch  Branch    @relation(fields: [branchId], references: [branchId])
  company companies @relation(fields: [companyId], references: [company_id])

  @@index([branchId])
  @@index([companyId])
  @@map("iot_devices")
}

// ======================================================
// FINGERPRINT TEMPLATE
// ======================================================

model FingerprintTemplate {
  templateId Int      @id @default(autoincrement()) @map("template_id")
  employeeId Int
  sensorSlot Int      @unique @map("sensor_slot")
  fingerName String?  @map("finger_name") @db.VarChar(30)
  status     String   @db.VarChar(20)
  enrolledAt DateTime @map("enrolled_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@map("fingerprint_templates")
}

// ======================================================
// ATTENDANCE PUNCH
// ======================================================

model AttendancePunch {
  punchId    BigInt   @id @default(autoincrement()) @map("punch_id")
  employeeId Int
  deviceId   Int
  sensorSlot Int      @map("sensor_slot")
  punchType  String   @map("punch_type") @db.VarChar(10)
  punchedAt  DateTime @map("punched_at")

  // Unique event identifier supplied by the biometric device.
  // Nullable so existing single-punch records remain valid.
  eventId String? @map("event_id") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  device   IotDevice @relation(fields: [deviceId], references: [deviceId])
  employee Employee  @relation(fields: [employeeId], references: [employeeId])

  @@unique([deviceId, eventId])
  @@index([employeeId])
  @@index([deviceId])
  @@index([sensorSlot])
  @@index([punchedAt])
  @@map("attendance_punches")
}

// ======================================================
// ATTENDANCE
// ======================================================

model Attendance {
  attendanceId Int       @id @default(autoincrement()) @map("attendance_id")
  employeeId   Int
  date         DateTime  @db.Date
  checkInTime  DateTime? @map("check_in_time") @db.Time(0)
  checkOutTime DateTime? @map("check_out_time") @db.Time(0)
  totalHours   Decimal?  @map("total_hours") @db.Decimal(5, 2)
  status       String    @db.VarChar(20)

  // DEVICE = real device OUT exists
  // AUTO_CLOSE = session resolved using office close time
  // ADMIN = explicit administrator correction
  resolutionSource String? @map("resolution_source") @db.VarChar(20)

  // Protect an explicit administrator correction from automatic recalculation.
  manualOverride   Boolean   @default(false) @map("manual_override")
  manualOverrideAt DateTime? @map("manual_override_at")
  manualOverrideBy Int?      @map("manual_override_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee            Employee @relation(fields: [employeeId], references: [employeeId])
  manualOverrideAdmin Admin?   @relation("AttendanceManualOverride", fields: [manualOverrideBy], references: [adminId])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([manualOverrideBy])
  @@map("attendance")
}

// ======================================================
// DEVICE LOG
// ======================================================

model DeviceLog {
  logId     BigInt   @id @default(autoincrement()) @map("log_id")
  deviceId  Int
  eventType String   @map("event_type") @db.VarChar(50)
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  device IotDevice @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId])
  @@index([eventType])
  @@index([createdAt])
  @@map("device_logs")
}

// ======================================================
// ADVANCE PAYMENT
// ======================================================

model AdvancePayment {
  advanceId  Int @id @default(autoincrement()) @map("advance_id")
  employeeId Int

  // Original amount requested by employee
  amount Decimal @db.Decimal(10, 2)

  // Amount approved by admin
  approvedAmount Decimal? @map("approved_amount") @db.Decimal(10, 2)

  // Actual amount paid by admin
  paidAmount Decimal? @map("paid_amount") @db.Decimal(10, 2)

  reason      String?  @db.Text
  paymentDate DateTime @map("payment_date") @db.Date

  approvedBy Int?
  status     String @db.VarChar(20)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deductedAt DateTime? @map("deducted_at")

  // Payroll that deducted this advance
  deductedInPayrollId Int? @unique @map("deducted_in_payroll_id")

  approver          Admin?   @relation("ApprovedAdvances", fields: [approvedBy], references: [adminId])
  deductedInPayroll Payroll? @relation("AdvancePayroll", fields: [deductedInPayrollId], references: [payrollId])
  employee          Employee @relation("EmployeeAdvances", fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([approvedBy])
  @@map("advance_payments")
}

// ======================================================
// PAYROLL
// ======================================================

model Payroll {
  payrollId  Int @id @default(autoincrement()) @map("payroll_id")
  employeeId Int

  payPeriodStart DateTime @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime @map("pay_period_end") @db.Date

  // Historical salary snapshot
  baseSalary           Decimal? @map("base_salary") @db.Decimal(12, 2)
  monthlyExpectedHours Decimal? @map("monthly_expected_hours") @db.Decimal(8, 2)
  salaryRatePerHour    Decimal? @map("salary_rate_per_hour") @db.Decimal(10, 2)

  // Attendance calculation
  totalWorkingHours   Decimal @map("total_working_hours") @db.Decimal(8, 2)
  regularWorkingHours Decimal @default(0.00) @map("regular_working_hours") @db.Decimal(8, 2)
  shortageHours       Decimal @default(0.00) @map("shortage_hours") @db.Decimal(8, 2)
  shortageDeduction   Decimal @default(0.00) @map("shortage_deduction") @db.Decimal(12, 2)
  extraHours          Decimal @default(0.00) @map("extra_hours") @db.Decimal(8, 2)

  // Paid public-holiday hours
  paidHolidayHours Decimal @default(0.00) @map("paid_holiday_hours") @db.Decimal(8, 2)

  // Salary
  basicSalary      Decimal @map("basic_salary") @db.Decimal(12, 2)
  incentiveAmount  Decimal @default(0.00) @map("incentive_amount") @db.Decimal(12, 2)
  advanceDeduction Decimal @default(0.00) @map("advance_deduction") @db.Decimal(12, 2)
  netSalary        Decimal @map("net_salary") @db.Decimal(12, 2)

  // Normal salary payment
  scheduledPaymentDate DateTime? @map("scheduled_payment_date") @db.Date
  paymentDate          DateTime? @map("payment_date") @db.Date
  status               String    @default("UNPAID") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  advanceDeductionRecord AdvancePayment? @relation("AdvancePayroll")
  employee               Employee        @relation(fields: [employeeId], references: [employeeId])

  // Extra-work and settlement history
  extraWorkRecords     ExtraWork[]
  extraWorkSettlements ExtraWorkSettlement[]

  @@index([employeeId])
  @@index([payPeriodStart, payPeriodEnd])
  @@index([status])
  @@index([scheduledPaymentDate])
  @@map("payroll")
}

// ======================================================
// EXTRA WORK
// ======================================================

model ExtraWork {
  extraWorkId Int @id @default(autoincrement()) @map("extra_work_id")
  employeeId  Int
  payrollId   Int @map("payroll_id")

  // The same payroll period may have multiple accumulation records.
  extraHours   Decimal @default(0.00) @map("extra_hours") @db.Decimal(8, 2)
  status       String  @default("ACCUMULATED") @db.VarChar(20)
  settlementId Int?    @map("settlement_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  employee   Employee             @relation(fields: [employeeId], references: [employeeId])
  payroll    Payroll              @relation(fields: [payrollId], references: [payrollId])
  settlement ExtraWorkSettlement? @relation(fields: [settlementId], references: [settlementId])

  @@index([employeeId])
  @@index([payrollId])
  @@index([status])
  @@index([settlementId])
  @@index([createdAt])
  @@map("extra_work")
}

// ======================================================
// EXTRA WORK SETTLEMENT
// ======================================================

model ExtraWorkSettlement {
  settlementId Int  @id @default(autoincrement()) @map("settlement_id")
  employeeId   Int
  payrollId    Int? @map("payroll_id")

  settledHours    Decimal  @map("settled_hours") @db.Decimal(8, 2)
  incentiveAmount Decimal  @map("incentive_amount") @db.Decimal(12, 2)
  settlementDate  DateTime @map("settlement_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  employee         Employee    @relation(fields: [employeeId], references: [employeeId])
  payroll          Payroll?    @relation(fields: [payrollId], references: [payrollId])
  extraWorkRecords ExtraWork[]

  @@index([employeeId])
  @@index([payrollId])
  @@index([settlementDate])
  @@map("extra_work_settlements")
}

// ======================================================
// PUBLIC HOLIDAY
// ======================================================

model PublicHoliday {
  publicHolidayId Int @id @default(autoincrement()) @map("public_holiday_id")
  companyId       Int
  branchId        Int

  holidayDate       DateTime @map("holiday_date") @db.Date
  holidayName       String   @map("holiday_name") @db.VarChar(150)
  dailyWorkingHours Decimal  @default(0.00) @map("daily_working_hours") @db.Decimal(5, 2)
  isPaid            Boolean  @default(true) @map("is_paid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company companies @relation(fields: [companyId], references: [company_id])
  branch  Branch    @relation(fields: [branchId], references: [branchId])

  @@unique([branchId, holidayDate])
  @@index([companyId])
  @@index([branchId])
  @@index([holidayDate])
  @@map("public_holidays")
}

// ======================================================
// ACTIVITY LOG
// ======================================================

model ActivityLog {
  logId       BigInt   @id @default(autoincrement()) @map("log_id")
  employeeId  Int?
  actionType  String   @map("action_type") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}

// ======================================================
// SETTINGS
// ======================================================

model Setting {
  settingId Int      @id @default(autoincrement()) @map("setting_id")
  companyId Int
  key       String   @db.VarChar(100)
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company companies @relation(fields: [companyId], references: [company_id])

  @@unique([companyId, key])
  @@index([companyId])
  @@map("settings")
}

// ======================================================
// COMPANY
// ======================================================

model companies {
  company_id    Int      @id @default(autoincrement())
  company_name  String   @db.VarChar(150)
  address       String?  @db.Text
  contact_email String?  @db.VarChar(150)
  contact_phone String?  @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime

  admins         Admin[]
  branches       Branch[]
  departments    Department[]
  employees      Employee[]
  devices        IotDevice[]
  leaveTypes     LeaveType[]
  settings       Setting[]
  publicHolidays PublicHoliday[]

  // Diamond Job Work relationships
  externalProcessors  ExternalProcessor[]
  jobWorkProcessTypes JobWorkProcessType[]
  jobWorkMachines     JobWorkMachine[]
  jobWorkOrders       JobWorkOrder[]
  jobWorkProcessRates JobWorkProcessRate[]
  jobWorkPayments     JobWorkPayment[]
}

// ======================================================
// LEAVE TYPE
// ======================================================

model LeaveType {
  leaveTypeId Int      @id @default(autoincrement()) @map("leave_type_id")
  companyId   Int      @map("company_id")
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(30)
  description String?  @db.Text
  annualQuota Decimal? @map("annual_quota") @db.Decimal(6, 2)

  // Built-in fallback leave type.
  isSystemDefault Boolean @default(false) @map("is_system_default")

  isPaid            Boolean  @default(true) @map("is_paid")
  requiresApproval  Boolean  @default(true) @map("requires_approval")
  allowHalfDay      Boolean  @default(true) @map("allow_half_day")
  allowCarryForward Boolean  @default(false) @map("allow_carry_forward")
  status            String   @default("ACTIVE") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]
  company  companies      @relation(fields: [companyId], references: [company_id])

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, isSystemDefault])
  @@index([status])
  @@map("leave_types")
}

// ======================================================
// LEAVE BALANCE
// ======================================================

model LeaveBalance {
  leaveBalanceId Int      @id @default(autoincrement()) @map("leave_balance_id")
  employeeId     Int      @map("employee_id")
  leaveTypeId    Int      @map("leave_type_id")
  year           Int
  allocated      Decimal  @default(0.00) @db.Decimal(6, 2)
  used           Decimal  @default(0.00) @db.Decimal(6, 2)
  remaining      Decimal  @default(0.00) @db.Decimal(6, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [employeeId])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}

// ======================================================
// LEAVE REQUEST
// ======================================================

model LeaveRequest {
  leaveRequestId Int @id @default(autoincrement()) @map("leave_request_id")
  employeeId     Int @map("employee_id")
  leaveTypeId    Int @map("leave_type_id")

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  totalDays Decimal  @map("total_days") @db.Decimal(6, 2)

  reason String? @db.Text
  status String  @default("PENDING") @db.VarChar(20)

  approvedBy Int?      @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  approvedStartDate DateTime? @map("approved_start_date") @db.Date
  approvedEndDate   DateTime? @map("approved_end_date") @db.Date
  approvedDays      Decimal?  @map("approved_days") @db.Decimal(6, 2)

  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [employeeId])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedStartDate, approvedEndDate])
  @@map("leave_requests")
}

// ======================================================
// FINGERPRINT ENROLLMENT
// ======================================================

model FingerprintEnrollment {
  enrollmentId Int       @id @default(autoincrement()) @map("enrollment_id")
  employeeId   Int       @map("employee_id")
  sensorSlot   Int       @map("sensor_slot")
  fingerName   String?   @map("finger_name") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(20)
  confidence   Int?
  errorMessage String?   @map("error_message") @db.Text
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId])
  @@index([status])
  @@index([sensorSlot])
  @@index([createdAt])
  @@map("fingerprint_enrollments")
}

// ======================================================
// DIAMOND JOB WORK - EXTERNAL PROCESSOR
// ======================================================

model ExternalProcessor {
  externalProcessorId Int      @id @default(autoincrement()) @map("external_processor_id")
  companyId           Int      @map("company_id")
  processorCode       String   @map("processor_code") @db.VarChar(30)
  name                String   @db.VarChar(150)
  contactPerson       String?  @map("contact_person") @db.VarChar(100)
  phone               String?  @db.VarChar(20)
  email               String?  @db.VarChar(150)
  address             String?  @db.Text
  gstin               String?  @db.VarChar(20)
  pan                 String?  @db.VarChar(10)
  paymentTerms        String?  @map("payment_terms") @db.VarChar(100)
  notes               String?  @db.Text
  status              String   @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company       companies            @relation(fields: [companyId], references: [company_id])
  jobWorkOrders JobWorkOrder[]
  monthlyRates  JobWorkProcessRate[]

  @@unique([companyId, processorCode])
  @@index([companyId])
  @@index([name])
  @@index([status])
  @@map("external_processors")
}

// ======================================================
// DIAMOND JOB WORK - MACHINE MASTER
// ======================================================

// Machines are company-scoped. Deactivate machines instead of deleting them
// so existing job orders and rate history remain intact.
model JobWorkMachine {
  machineId   Int      @id @default(autoincrement()) @map("machine_id")
  companyId   Int      @map("company_id")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       companies            @relation(fields: [companyId], references: [company_id])
  jobWorkOrders JobWorkOrder[]
  monthlyRates  JobWorkProcessRate[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@map("job_work_machines")
}

// ======================================================
// DIAMOND JOB WORK - PROCESS TYPE MASTER
// ======================================================

model JobWorkProcessType {
  processTypeId Int      @id @default(autoincrement()) @map("process_type_id")
  companyId     Int      @map("company_id")
  code          String   @db.VarChar(30)
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  chargeUnit    String?  @map("charge_unit") @db.VarChar(20)
  defaultRate   Decimal? @map("default_rate") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company       companies            @relation(fields: [companyId], references: [company_id])
  jobWorkOrders JobWorkOrder[]
  monthlyRates  JobWorkProcessRate[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@map("job_work_process_types")
}

// ======================================================
// DIAMOND JOB WORK - MONTHLY PROCESSING RATE
// ======================================================

// One rate is configured for each internal company, external processor, machine,
// processing type, and calendar month. Store rateMonth as the first day of the
// month, e.g. 2026-11-01.
//
// externalProcessorId and machineId are nullable during the transition so existing rate
// rows can be retained and backfilled safely. New rate writes must supply both.
// The service must select the latest applicable rate on or before the receipt
// month when an exact-month rate does not exist.
model JobWorkProcessRate {
  processRateId Int @id @default(autoincrement()) @map("process_rate_id")

  companyId           Int      @map("company_id")
  externalProcessorId Int?     @map("external_processor_id")
  machineId           Int?     @map("machine_id")
  processTypeId       Int      @map("process_type_id")
  rateMonth           DateTime @map("rate_month") @db.Date
  chargeUnit          String   @map("charge_unit") @db.VarChar(20)
  rate                Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company           companies          @relation(fields: [companyId], references: [company_id])
  externalProcessor ExternalProcessor? @relation(fields: [externalProcessorId], references: [externalProcessorId])
  machine           JobWorkMachine?    @relation(fields: [machineId], references: [machineId])
  processType       JobWorkProcessType @relation(fields: [processTypeId], references: [processTypeId])

  @@unique([companyId, externalProcessorId, machineId, processTypeId, rateMonth])
  @@index([companyId, rateMonth])
  @@index([externalProcessorId, machineId, processTypeId, rateMonth])
  @@index([processTypeId, rateMonth])
  @@map("job_work_process_rates")
}

// ======================================================
// DIAMOND JOB WORK - JOB ORDER
// ======================================================

model JobWorkOrder {
  jobWorkOrderId      Int      @id @default(autoincrement()) @map("job_work_order_id")
  companyId           Int      @map("company_id")
  branchId            Int      @map("branch_id")
  jobNumber           String   @map("job_number") @db.VarChar(40)
  externalProcessorId Int      @map("external_processor_id")
  machineId           Int?     @map("machine_id")
  processTypeId       Int      @map("process_type_id")
  orderDate           DateTime @map("order_date") @db.Date

  // Initial quotation/reference rate when the order begins.
  // Actual charge is based on each receipt's month.
  quotedRate       Decimal?  @map("quoted_rate") @db.Decimal(12, 2)
  quotedChargeUnit String?   @map("quoted_charge_unit") @db.VarChar(20)
  quotedRateMonth  DateTime? @map("quoted_rate_month") @db.Date

  status           String   @default("OPEN") @db.VarChar(30)
  description      String?  @db.Text
  notes            String?  @db.Text
  createdByAdminId Int?     @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company           companies               @relation(fields: [companyId], references: [company_id])
  branch            Branch                  @relation(fields: [branchId], references: [branchId])
  externalProcessor ExternalProcessor       @relation(fields: [externalProcessorId], references: [externalProcessorId])
  machine           JobWorkMachine?         @relation(fields: [machineId], references: [machineId])
  processType       JobWorkProcessType      @relation(fields: [processTypeId], references: [processTypeId])
  createdByAdmin    Admin?                  @relation("JobWorkOrderCreatedBy", fields: [createdByAdminId], references: [adminId])
  dispatches        JobWorkDispatch[]
  reconciliations   JobWorkReconciliation[]
  payments          JobWorkPayment[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([externalProcessorId])
  @@index([machineId])
  @@index([processTypeId])
  @@index([status])
  @@index([orderDate])
  @@index([createdByAdminId])
  @@map("job_work_orders")
}

// ======================================================
// DIAMOND JOB WORK - PAYMENT
// ======================================================

// Records payments toward job-work charges. Outstanding balances will be
// calculated by the service from priced receipt items minus payments.
model JobWorkPayment {
  paymentId         Int      @id @default(autoincrement()) @map("payment_id")
  companyId         Int      @map("company_id")
  jobWorkOrderId    Int      @map("job_work_order_id")
  paymentDate       DateTime @map("payment_date") @db.Date
  amount            Decimal  @db.Decimal(12, 2)
  paymentMethod     String?  @map("payment_method") @db.VarChar(30)
  referenceNumber   String?  @map("reference_number") @db.VarChar(100)
  notes             String?  @db.Text
  recordedByAdminId Int?     @map("recorded_by_admin_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company         companies    @relation(fields: [companyId], references: [company_id])
  jobWorkOrder    JobWorkOrder @relation(fields: [jobWorkOrderId], references: [jobWorkOrderId])
  recordedByAdmin Admin?       @relation("JobWorkPaymentRecordedBy", fields: [recordedByAdminId], references: [adminId])

  @@index([companyId])
  @@index([jobWorkOrderId])
  @@index([paymentDate])
  @@index([recordedByAdminId])
  @@map("job_work_payments")
}

// ======================================================
// DIAMOND JOB WORK - DISPATCH
// ======================================================

model JobWorkDispatch {
  dispatchId         Int       @id @default(autoincrement()) @map("dispatch_id")
  jobWorkOrderId     Int       @map("job_work_order_id")
  challanNumber      String?   @map("challan_number") @db.VarChar(50)
  jangadNumber       String?   @map("jangad_number") @db.VarChar(50)
  dispatchDate       DateTime  @map("dispatch_date") @db.Date
  expectedReturnDate DateTime? @map("expected_return_date") @db.Date
  sentPieces         Int       @map("sent_pieces")
  sentCarats         Decimal   @map("sent_carats") @db.Decimal(12, 4)
  sentWeightGrams    Decimal   @map("sent_weight_grams") @db.Decimal(12, 6)
  notes              String?   @db.Text
  createdByAdminId   Int?      @map("created_by_admin_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jobWorkOrder   JobWorkOrder     @relation(fields: [jobWorkOrderId], references: [jobWorkOrderId])
  createdByAdmin Admin?           @relation("JobWorkDispatchCreatedBy", fields: [createdByAdminId], references: [adminId])
  receipts       JobWorkReceipt[]

  @@index([jobWorkOrderId])
  @@index([dispatchDate])
  @@index([expectedReturnDate])
  @@index([challanNumber])
  @@index([jangadNumber])
  @@index([createdByAdminId])
  @@map("job_work_dispatches")
}

// ======================================================
// DIAMOND JOB WORK - RECEIPT
// ======================================================

// A dispatch may have multiple partial receipts.
model JobWorkReceipt {
  receiptId         Int      @id @default(autoincrement()) @map("receipt_id")
  dispatchId        Int      @map("dispatch_id")
  receiptNumber     String?  @map("receipt_number") @db.VarChar(50)
  receivedDate      DateTime @map("received_date") @db.Date
  receivedByAdminId Int?     @map("received_by_admin_id")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  dispatch        JobWorkDispatch      @relation(fields: [dispatchId], references: [dispatchId])
  receivedByAdmin Admin?               @relation("JobWorkReceiptRecordedBy", fields: [receivedByAdminId], references: [adminId])
  items           JobWorkReceiptItem[]

  @@index([dispatchId])
  @@index([receivedDate])
  @@index([receiptNumber])
  @@index([receivedByAdminId])
  @@map("job_work_receipts")
}

// ======================================================
// DIAMOND JOB WORK - RECEIPT ITEM
// ======================================================

// Carats and grams remain separate measurements. There is no conversion.
model JobWorkReceiptItem {
  receiptItemId       Int     @id @default(autoincrement()) @map("receipt_item_id")
  receiptId           Int     @map("receipt_id")
  returnCondition     String  @map("return_condition") @db.VarChar(30)
  returnedPieces      Int     @map("returned_pieces")
  returnedCarats      Decimal @map("returned_carats") @db.Decimal(12, 4)
  returnedWeightGrams Decimal @map("returned_weight_grams") @db.Decimal(12, 6)

  // Historical price snapshot for the receipt. rateMonth is the receipt's
  // calendar month; appliedRateMonth identifies the month from which the rate
  // was sourced. A different month makes carry-forward pricing auditable.
  // rateSource may be EXACT_MONTH, CARRIED_FORWARD, or MANUAL_OVERRIDE.
  rateMonth         DateTime? @map("rate_month") @db.Date
  appliedRateMonth  DateTime? @map("applied_rate_month") @db.Date
  rateSource        String?   @map("rate_source") @db.VarChar(30)
  appliedChargeUnit String?   @map("applied_charge_unit") @db.VarChar(20)
  appliedRate       Decimal?  @map("applied_rate") @db.Decimal(12, 2)
  billableQuantity  Decimal?  @map("billable_quantity") @db.Decimal(12, 6)
  processingCharge  Decimal?  @map("processing_charge") @db.Decimal(12, 2)

  remarks   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  receipt JobWorkReceipt @relation(fields: [receiptId], references: [receiptId])

  @@index([receiptId])
  @@index([returnCondition])
  @@map("job_work_receipt_items")
}

// ======================================================
// DIAMOND JOB WORK - RECONCILIATION
// ======================================================

model JobWorkReconciliation {
  reconciliationId   Int       @id @default(autoincrement()) @map("reconciliation_id")
  jobWorkOrderId     Int       @map("job_work_order_id")
  reportedLossCarats Decimal?  @map("reported_loss_carats") @db.Decimal(12, 4)
  approvedLossCarats Decimal?  @map("approved_loss_carats") @db.Decimal(12, 4)
  varianceCarats     Decimal?  @map("variance_carats") @db.Decimal(12, 4)
  status             String    @default("PENDING") @db.VarChar(20)
  reviewedByAdminId  Int?      @map("reviewed_by_admin_id")
  reviewedAt         DateTime? @map("reviewed_at")
  resolutionNotes    String?   @map("resolution_notes") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  jobWorkOrder    JobWorkOrder @relation(fields: [jobWorkOrderId], references: [jobWorkOrderId])
  reviewedByAdmin Admin?       @relation("JobWorkReconciliationReviewedBy", fields: [reviewedByAdminId], references: [adminId])

  @@index([jobWorkOrderId])
  @@index([status])
  @@index([reviewedByAdminId])
  @@index([createdAt])
  @@map("job_work_reconciliations")
}
